# ---------- Obrigatórias ----------

# Senha do painel. Pelo menos 12 caracteres (com menos, o cofre não inicia em produção).
ADMIN_PASSWORD=

# Assina o login e protege os tokens guardados. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde junto com o backup do cofre e não troque depois de criar clientes: se ela mudar,
# os tokens deixam de aparecer no painel (mas continuam funcionando).
SESSION_SECRET=

# ---------- Recomendadas em produção ----------

# Endereço público do cofre, usado no prompt e nos exemplos da página do cliente.
# Sem ele, o endereço é deduzido da requisição e pode sair como http:// atrás de alguns proxies.
# PUBLIC_URL=https://backups.seudominio.com

# Ligue (1) quando o cofre estiver atrás de um proxy (Traefik/Coolify, Caddy, Nginx). Assim o limite
# de tentativas de login usa o IP real do visitante. Sem proxy, deixe desligado: o cabeçalho pode ser falsificado.
# TRUST_PROXY=1

# ---------- Opcionais ----------

# Tamanho de cada pedaço do upload, em MB. Cada pedaço precisa subir antes do tempo-limite
# do proxy (60 s no Traefik do Coolify). Menor = mais resistente a internet lenta.
# CHUNK_SIZE_MB=16

# Uploads parados há mais que isso (em horas) são descartados.
# STALE_UPLOAD_HOURS=48

# Fuso usado para mostrar as datas no painel.
# TIMEZONE=America/Sao_Paulo

# Só para rodar sem Docker (no Docker, os dados ficam sempre em /data e a porta é a 3000):
# DATA_DIR=./data
# PORT=3000
